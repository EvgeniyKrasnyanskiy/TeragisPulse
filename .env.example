# --- Настройки Базы Данных ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=teragis_db
DB_USER=postgres
DB_PASS=password

# --- Настройки Telegram Bot API ---
# Получить у @BotFather
TG_BOT_TOKEN=123456789:ABCDEF...

# API ID и HASH (получить на my.telegram.org)
TG_API_ID=1234567
TG_API_HASH=abcdef123456...

# ID администраторов через запятую (кто может управлять ботом)
TG_ADMIN_IDS=12345678,98765432

# --- Каналы для рассылок (ID групп) ---
TG_CHANNEL_ID_1RO=-100...
TG_CHANNEL_ID_2RO=-100...

# --- Настройки Прокси (MTProxy/WebSocket) ---
PROXY_HOST=127.0.0.1
PROXY_PORT=8888
PROXY_SECRET=
